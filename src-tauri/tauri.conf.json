{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morph",
  "version": "0.1.1",
  "identifier": "app.morph.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Morph",
    "category": "Utility",
    "shortDescription": "Convert and edit files from a radial menu",
    "longDescription": "Press a hotkey or right-click a file, then pick an action from a radial menu: convert, crop, resize, shrink and merge images, video, audio, PDFs and documents. Everything runs on your computer; nothing is uploaded.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "copyright": "Copyright © 2026 Sreyash Singh. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2OURCNTNDMTBFM0ZFNjEKUldSaC91TVFQTFdkeGhQRGdtMFhOSnZJSm9xN1pyOHpTL3NKK3hRUVBGQlRuMEl5VXp0NDlndjUK",
      "endpoints": [
        "https://github.com/itsofficially-sreyash/Morph/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
