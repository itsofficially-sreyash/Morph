<?xml version="1.0" encoding="utf-8"?>
<!-- Morph's addition to Tauri's MSI (bundle.windows.wix.fragmentPaths): on uninstall (not
     an upgrade), run `morph.exe --remove-integration` as the user, so the right-click entry
     and start-at-sign-in (both per user, in HKCU) go too. "Path" is the main binary's
     File Id in Tauri's main.wxs. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <!-- Referenced from tauri.conf.json (componentGroupRefs) so WiX links this fragment. -->
    <ComponentGroup Id="MorphRemoveIntegration" />
    <CustomAction Id="MorphRemoveIntegration" FileKey="Path" ExeCommand="--remove-integration"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="MorphRemoveIntegration" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
