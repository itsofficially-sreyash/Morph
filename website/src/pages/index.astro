---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WaysIn from '../components/WaysIn.astro';
import IHave from '../components/IHave.astro';
import Bento from '../components/Bento.astro';
import Features from '../components/Features.astro';
import Private from '../components/Private.astro';
import VideoSection from '../components/VideoSection.astro';
import Download from '../components/Download.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Morph: convert anything, in one drop"
  description="Free, open-source file converter for Windows and Linux. Press a shortcut, drop files on the orb, pick what you want. Everything runs on your computer."
>
  <Nav />
  <main id="main">
    <Hero />
    <WaysIn />
    <IHave />
    <Bento />
    <Features />
    <Private />
    <VideoSection />
    <Download />
    <Faq />
  </main>
  <Footer />
</Base>
