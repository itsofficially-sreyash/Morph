---
const rows = [
  {
    clip: 'crop',
    title: 'Crop by drawing a box.',
    text: 'Pick Crop, drag a box over your photo, and Save. Ratios like 1:1 and 16:9 are one click away. The result is saved next to the original.',
  },
  {
    clip: 'merge',
    title: 'Merge in the order you choose.',
    text: 'Drop your PDFs on the orb, drag them into order, and Merge. One file, every page.',
  },
  {
    clip: 'split',
    title: 'Split exactly the pages you need.',
    text: 'Every page on its own, or ranges like 1-3, 5, 8-. Morph checks the ranges before it starts.',
  },
];
---

<section class="features">
  <div class="container">
    <div class="section-head center" data-reveal>
      <span class="eyebrow">Tools when you need them</span>
      <h2>Some jobs need a little more.</h2>
      <p>For those, Morph opens a small window with just what that job needs, then gets out of the way.</p>
    </div>

    <div class="rows">
      {
        rows.map((r, i) => (
          <div class:list={['row', { flip: i % 2 === 1 }]} data-reveal>
            <div class="copy">
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </div>
            <div class="frame">
              <video
                data-clip
                src={`/media/${r.clip}.mp4`}
                poster={`/media/${r.clip}.jpg`}
                width="1280"
                height="720"
                muted
                loop
                playsinline
                preload="none"
                aria-label={`Screen recording: ${r.title}`}
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Clips play only while on screen, and never with reduced motion (the poster shows instead).
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.4 },
    );
    document.querySelectorAll('[data-clip]').forEach((v) => io.observe(v));
  }
</script>

<style>
  .features {
    padding-top: 0;
  }

  .rows {
    display: grid;
    gap: clamp(56px, 8vw, 96px);
  }

  .row {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
    }

    .row.flip {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .row.flip .copy {
      order: 2;
    }
  }

  .copy h3 {
    font-size: clamp(24px, 2.8vw, 32px);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .copy p {
    margin-top: 14px;
    color: var(--muted);
    font-size: 18px;
    max-width: 42ch;
  }

  .frame {
    position: relative;
    padding: 8px;
    border-radius: 20px;
    background: linear-gradient(180deg, #24212d, #17151d);
    border: 1px solid var(--border-strong);
    box-shadow:
      0 30px 70px -30px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(0 0 0 / 0.3);
  }

  .frame::before {
    content: '';
    position: absolute;
    inset: 10% 5% -8%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(124 92 255 / 0.22), transparent);
    filter: blur(10px);
  }

  video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 13px;
    background: #cfd8e6;
  }
</style>
