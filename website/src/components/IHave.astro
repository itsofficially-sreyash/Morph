---
const rows = [
  { have: 'An iPhone photo my computer won’t open', get: 'A JPG, in one drop', hue: 262 },
  { have: 'A video too big to send', get: '<b>Shrink</b>: the same video, a fraction of the size', hue: 335 },
  { have: 'Two PDFs that should be one', get: '<b>Merge</b>, in the order I choose', hue: 12 },
  { have: 'A 40-page PDF when I need 3 pages', get: '<b>Split</b> by page ranges, like 1-3, 5', hue: 12 },
  { have: 'A song in the wrong format', get: 'MP3, WAV, FLAC or M4A', hue: 172 },
  { have: 'A Word file someone wants as a PDF', get: '<b>Save as PDF</b>', hue: 210 },
  { have: 'A photo with too much around it', get: '<b>Crop</b> by drawing a box', hue: 262 },
];
---

<section class="ihave">
  <div class="container">
    <div class="section-head center" data-reveal>
      <h2>Tell it what you have.</h2>
      <p>Morph shows only what makes sense for your files.</p>
    </div>

    <div class="table" role="table" aria-label="What Morph does with your files">
      <div class="row head" role="row">
        <span role="columnheader">I have…</span>
        <span role="columnheader">Morph gives me…</span>
      </div>
      {
        rows.map((r, i) => (
          <div class="row" role="row" style={`--hue:${r.hue};--i:${i}`} data-reveal>
            <span class="have" role="cell">
              {r.have}
            </span>
            <span class="get" role="cell">
              <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 12h15m-5-5 5 5-5 5" />
              </svg>
              <span set:html={r.get} />
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ihave {
    padding-top: 0;
  }

  .table {
    max-width: 880px;
    margin-inline: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface);
    overflow: hidden;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: center;
    padding: 18px 28px;
    border-top: 1px solid var(--border);
    transition: background-color var(--dur) var(--ease-out);
  }

  .row.head {
    border-top: 0;
    padding-block: 14px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
    background: rgb(255 255 255 / 0.02);
  }

  .row:not(.head):hover {
    background: hsl(var(--hue) 60% 50% / 0.07);
  }

  .have {
    color: var(--muted);
    transition: color var(--dur) var(--ease-out);
  }

  .row:hover .have {
    color: var(--text);
  }

  .get {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .get :global(b) {
    color: hsl(var(--hue) 85% 78%);
    font-weight: 600;
  }

  .arrow {
    width: 20px;
    flex: none;
    fill: none;
    stroke: hsl(var(--hue) 70% 68%);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur) var(--ease-out);
  }

  .row:hover .arrow {
    transform: translateX(3px);
  }

  @media (max-width: 680px) {
    .table {
      border: 0;
      background: none;
      display: grid;
      gap: 10px;
    }

    .row.head {
      display: none;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 16px 18px;
      border: 1px solid var(--border);
      border-radius: var(--radius-m);
      background: var(--surface);
    }

    .have {
      font-size: 15px;
    }
  }
</style>
